<Window x:Class="AppInventory.ScanScopeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择只读扫描范围" Width="760" Height="690" MinWidth="650" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="#F4F5F1" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13">
    <Grid Margin="26">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="便携软件与关联位置" FontSize="25" FontWeight="SemiBold" Foreground="#23362F" />
            <TextBlock Text="只读取目录、文件大小和程序元数据，不运行扫描到的软件。" Margin="0,9,0,14" Foreground="#60715D" />
            <CheckBox x:Name="FixedCheck" Content="自动包含所有固定磁盘" IsChecked="True" Checked="Scope_Changed" Unchecked="Scope_Changed" AutomationProperties.Name="自动包含所有固定磁盘" />
        </StackPanel>
        <TextBlock x:Name="ScopeSummary" Grid.Row="1" Margin="0,13,0,15" Foreground="#42664C" TextWrapping="Wrap" />
        <Grid Grid.Row="2" Margin="0,0,0,15">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Content="添加目录" Click="AddRoot_Click" Margin="0,0,7,0" AutomationProperties.Name="添加扫描目录" />
                    <Button Content="移出范围" Click="RemoveRoot_Click" AutomationProperties.Name="移出选中的扫描目录" />
                </StackPanel>
                <TextBlock Text="额外扫描目录" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <ListBox x:Name="RootList" Grid.Row="1" BorderBrush="#CDD8CD" Background="White" Padding="8" AutomationProperties.Name="额外扫描目录列表" />
        </Grid>
        <Grid Grid.Row="3">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Content="排除目录" Click="AddExclusion_Click" Margin="0,0,7,0" AutomationProperties.Name="添加排除目录" />
                    <Button Content="取消排除" Click="RemoveExclusion_Click" AutomationProperties.Name="取消选中目录的排除" />
                </StackPanel>
                <TextBlock Text="排除目录及其子目录" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <ListBox x:Name="ExclusionList" Grid.Row="1" BorderBrush="#CDD8CD" Background="White" Padding="8" AutomationProperties.Name="排除目录列表" />
            <TextBlock Grid.Row="2" Text="默认略过 Windows、回收站、系统恢复、开发依赖目录及链接。排除或权限不足时，大小会标为部分结果。" Foreground="#667761" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="18" />
        </Grid>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="取消" IsCancel="True" Margin="0,0,10,0" />
            <Button x:Name="StartButton" Content="开始只读扫描" Click="Start_Click" IsDefault="True" AutomationProperties.Name="开始只读扫描" />
        </StackPanel>
    </Grid>
</Window>
